{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "flux-blocks/query-grid",
	"version": "0.1.0",
	"title": "Query Grid",
	"category": "flux-blocks",
	"icon": "grid-view",
	"description": "A filterable, paginated grid of posts with search and category chips.",
	"keywords": [ "posts", "grid", "query", "loop", "filter", "pagination" ],

	"attributes": {
		"showHeading": {
			"type": "boolean",
			"default": true
		},
		"heading": {
			"type": "string",
			"default": "Latest Articles & News"
		},
		"headingAccent": {
			"type": "string",
			"default": ""
		},
		"showSearch": {
			"type": "boolean",
			"default": true
		},
		"showCategoryFilter": {
			"type": "boolean",
			"default": true
		},
		"facetTaxonomies": {
			"type": "array",
			"default": []
		},
		"showSidebar": {
			"type": "boolean",
			"default": false
		},
		"sidebarSide": {
			"type": "string",
			"default": "left"
		},
		"showFilterHeadings": {
			"type": "boolean",
			"default": true
		},
		"facetHeadings": {
			"type": "object",
			"default": {}
		},
		"searchAlign": {
			"type": "string",
			"default": "center"
		},
		"paginationStyle": {
			"type": "string",
			"default": "numbers"
		},
		"showAllPosts": {
			"type": "boolean",
			"default": false
		},
		"carouselItemsPerView": {
			"type": "number",
			"default": 3
		},
		"postType": {
			"type": "string",
			"default": "post"
		},
		"postCount": {
			"type": "number",
			"default": 9
		},
		"orderBy": {
			"type": "string",
			"default": "date"
		},
		"order": {
			"type": "string",
			"default": "desc"
		},
		"columns": {
			"type": "object",
			"default": { "mobile": 1, "tablet": 2, "desktop": 3 }
		},
		"colors": {
			"type": "object",
			"default": {
				"titleColor": "",
				"accentColor": "",
				"subheadingColor": "",
				"cardTitleColor": "",
				"cardTitleHoverColor": "",
				"cardExcerptColor": "",
				"readMoreColor": "",
				"readMoreHoverColor": "",
				"activeAccent": "",
				"disabledNav": "",
				"inactivePillBg": "",
				"inactivePillText": "",
				"metaText": "",
				"authorText": ""
			}
		},
		"typography": {
			"type": "object",
			"default": {
				"headingTitleFontFamily": "",
				"headingTitleFontWeight": "",
				"cardTitleFontFamily": "",
				"cardTitleFontWeight": "",
				"cardExcerptFontFamily": "",
				"cardExcerptFontWeight": "",
				"metaFontFamily": "",
				"metaFontWeight": "",
				"filterPaginationFontFamily": "",
				"filterPaginationFontWeight": ""
			}
		},
		"queryId": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"interactivity": true,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"styles": [
		{ "name": "grid", "label": "Grid", "isDefault": true },
		{ "name": "list", "label": "List" },
		{ "name": "masonry", "label": "Masonry" },
		{ "name": "carousel", "label": "Carousel" }
	],
	"textdomain": "flux-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScriptModule": "file:./view.js"
}
