{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "flux-blocks/featured-cpt-section",
	"version": "0.1.0",
	"title": "Featured CPT Section",
	"category": "flux-blocks",
	"icon": "media-interactive",
	"description": "Showcase a curated or automatic selection of posts from any public post type, with carousel navigation and hover hotspots.",
	"example": {},
	"attributes": {
		"postType": {
			"type": "string",
			"default": "post"
		},
		"selectionMode": {
			"type": "string",
			"default": "automatic"
		},
		"manualIds": {
			"type": "array",
			"default": []
		},
		"postCount": {
			"type": "number",
			"default": 6
		},
		"orderBy": {
			"type": "string",
			"default": "date"
		},
		"order": {
			"type": "string",
			"default": "desc"
		},
		"taxonomyFilter": {
			"type": "object",
			"default": { "taxonomy": "", "terms": [] }
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"description": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"interactivity": true,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"textdomain": "flux-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScriptModule": "file:./view.js"
}
