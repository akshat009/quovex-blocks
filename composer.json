{
	"name": "quovex-blocks/quovex-blocks",
	"description": "Custom Gutenberg block category with a Query Grid, a Content Showcase, and a Notification Banner block for any public post type.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Akshat",
			"homepage": "https://github.com/akshat009"
		}
	],
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpunit/phpunit": "^9.6",
		"brain/monkey": "^2.6",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"doctrine/instantiator": "^1.5",
		"myclabs/deep-copy": ">=1.13.0 <1.14.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"test": "phpunit"
	},
	"autoload": {
		"psr-4": {
			"QuovexBlocks\\": "includes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"QuovexBlocks\\Tests\\": "tests/"
		}
	}
}
