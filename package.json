{
	"name": "quovex-blocks",
	"version": "1.0.0",
	"description": "Custom Gutenberg block category with a Query Grid, a Content Showcase, and a Notification Banner block for any public post type.",
	"author": "Akshat",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build --experimental-modules --blocks-manifest",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"make-pot": "wp i18n make-pot . languages/quovex-blocks.pot",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start --experimental-modules --blocks-manifest",
		"test:unit:js": "wp-scripts test-unit-js",
		"prepare": "husky"
	},
	"dependencies": {
		"@wordpress/interactivity": "^6.52.0"
	},
	"files": [
		"build/**",
		"includes/**",
		"languages/**",
		"quovex-blocks.php",
		"uninstall.php",
		"readme.txt",
		"README.md",
		"LICENSE.txt"
	],
	"devDependencies": {
		"@wordpress/api-fetch": "^7.52.0",
		"@wordpress/block-editor": "^16.1.0",
		"@wordpress/blocks": "^15.25.0",
		"@wordpress/components": "^38.0.0",
		"@wordpress/core-data": "^7.52.0",
		"@wordpress/data": "^10.52.0",
		"@wordpress/element": "^8.4.0",
		"@wordpress/i18n": "^6.25.0",
		"@wordpress/scripts": "^34.0.0",
		"@wordpress/server-side-render": "^6.28.0",
		"husky": "^9.1.7"
	}
}
