# Dependencies -- installed via `npm install`/`composer install`, not hand-written.
# Anyone cloning this repo runs those commands themselves; committing these
# folders would bloat the repo and go stale immediately.
node_modules/
vendor/

# Compiled output -- generated by `npm run build` from src/. Never hand-edit
# these files; committing them would just create merge conflicts with the
# real source of truth (src/).
build/

# Packaged plugin zip (from `npm run plugin-zip`).
*.zip

# Raw/framed screenshot captures from scripts/capture-screenshots.py and
# scripts/frame-screenshots.py -- disposable scratch output, regenerate any
# time by re-running those scripts. The curated final picks live in assets/
# as screenshot-N.png (committed, since that's what ships to WP.org).
scripts/output/

# Internal planning docs (PRD/architecture/technical-spec) -- not meant for
# the public repo, kept locally only.
docs/

# npm/composer debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
composer-debug.log

# Environment/secrets -- never commit real credentials.
.env
.env.local

# Editor/IDE folders
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS junk files
.DS_Store
Thumbs.db
desktop.ini

# Local WordPress debug log, if WP_DEBUG_LOG is ever turned on inside this folder
debug.log

# PHPUnit's own test-run cache (which tests passed/failed last time, for
# --order-by=defects etc.) -- regenerated on every `composer test` run,
# machine-specific, never meant to be committed.
.phpunit.result.cache
